# StudyMate AI - Backend Environment Configuration
# IIT Mandi Multimodal AI Hackathon 2026 - Track D

# Server-side Gemini API Key (Never expose to frontend or git commits)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
GEMINI_MODEL=gemini-flash-latest

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database & Storage
DB_PATH=./studymate.db
UPLOAD_DIR=./uploads
